# Supabase project settings (Supabase dashboard -> Project Settings -> API)
# Server-only: read by the contact-form server action (app/actions/request-demo.ts).
# Never expose to the client. Inserts go to public.inquiries (RLS: INSERT only).
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# New-inquiry email notification via the Resend API (lib/notify.server.ts). Server-only.
# Optional: while RESEND_API_KEY is empty, submissions are still stored and the notification
# is skipped (one log line, no submission content). A failed notification never fails a submission.
RESEND_API_KEY=""
# Recipient (comma-separated list allowed). Default: armaan@ordinum.org.
# For tests use Resend's test recipient only: delivered@resend.dev
INQUIRY_NOTIFY_TO=""
# Sender. Default: "Ordinum Website <onboarding@resend.dev>" (Resend's shared test sender).
# In production use an address on a domain verified in Resend, e.g. "Ordinum Website <website@your-verified-domain>".
INQUIRY_NOTIFY_FROM=""
